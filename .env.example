# Inference Scaffold Environment Variables
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# Provider API Keys
# =============================================================================

# OpenRouter API key (required for openrouter provider – free tier: 50 RPD / 20 RPM)
# Get your key at: https://openrouter.ai/keys
# Free models: https://openrouter.ai/models?fmt=cards&max_price=0&output_modalities=text&input_modalities=text
# Multiple keys: comma-separate to enable automatic rotation on rate limits.
# Rotation applies to :free models only; paid models always use the FIRST key.
# OPENROUTER_API_KEY=sk-or-v1-primary,sk-or-v1-key-two
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Mock API key (TEST ONLY – not required for real API calls)
# Used for local testing and running examples without an OpenRouter key
MOCK_API_KEY=mock-key-placeholder

# vLLM (see config/inference.vllm.example.yaml). Loopback server without --api-key accepts any bearer token.
VLLM_API_KEY=EMPTY

# Modal (see config/inference.modal.example.yaml + experiments/modal_gpu_poc/README.md).
# Deploy/serve auth for the Modal SDK/CLI (needed only to deploy the GPU server):
# MODAL_TOKEN_ID=ak-your-modal-token-id
# MODAL_TOKEN_SECRET=as-your-modal-token-secret
# The deployed vLLM server's URL (printed by `modal deploy`) + its bearer token.
# MODAL_BASE_URL overrides the base_url in config/inference.modal.example.yaml.
# Hostname includes app + function name, e.g. …--pers-subject-serve-serve.modal.run
# MODAL_BASE_URL=https://<workspace>--pers-subject-serve-serve.modal.run/v1
MODAL_API_KEY=EMPTY

# HF token — required for gated subject models on Modal (Ministral 3, Llama, …).
# setup_modal_hf.py verifies access and replaces the Modal huggingface-token secret.
# Run: python experiments/modal_gpu_poc/setup_modal_hf.py --model-id <repo>
# HF_TOKEN=hf_your_token_here

# =============================================================================
# Optional Configuration
# =============================================================================

# Default provider when not specified (optional)
# INFERENCE_DEFAULT_PROVIDER=openrouter

# Log level for the inference library (optional)
# INFERENCE_LOG_LEVEL=INFO
